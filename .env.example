# Copy this file to `.env` and fill in the values. `.env` is ignored by git.
# Only variables that the code actually reads are listed here.
# In production, set these in your host's environment/secret settings instead of a file.

NODE_ENV=development
PORT=4000

# PostgreSQL. DIRECT_URL is used by Prisma migrations (set it to the same value
# unless you run behind a connection pooler such as PgBouncer or Neon's pooled endpoint).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/serveos_dev?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5433/serveos_dev?schema=public
# Separate database that the automated API tests wipe and recreate. Not needed in production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/serveos_test?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# WEB_URL is put into invitation/reset emails and suggested for table QR codes.
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
# Comma separated list of browser origins allowed to call the API (web app and kitchen display).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Payments.
#   none     - no online payment; card/UPI are recorded by staff, guests pay at the counter
#   dev      - simulator for development only; refused when NODE_ENV=production
#   razorpay - Razorpay Standard Checkout for guest (QR) orders
PAYMENT_PROVIDER=dev
# Razorpay: key id (rzp_test_... or rzp_live_...) and key secret from Dashboard > Account & Settings > API Keys.
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
# dev: any random string of 32+ characters. razorpay: the secret you type when creating the webhook.
PAYMENT_WEBHOOK_SECRET=

# File storage for product images. Only `local` (the API server's disk) is implemented.
STORAGE_PROVIDER=local

# Email.
#   dev    - nothing is sent; messages appear in the API log and at /api/v1/dev/outbox
#   resend - sends through Resend; EMAIL_FROM must be an address on a domain verified in Resend
EMAIL_PROVIDER=dev
EMAIL_API_KEY=
EMAIL_FROM=ServeOS <no-reply@serveos.local>

# Development seed only: password assigned to the demo users.
SEED_DEMO_PASSWORD=
