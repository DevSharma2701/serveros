# Copy this file to `.env` and fill in the values. `.env` is ignored by git.
# Only variables that the code actually reads are listed here.

NODE_ENV=development
PORT=4000

# PostgreSQL. DIRECT_URL is used by Prisma migrations (set it to the same value
# unless you run behind a connection pooler such as PgBouncer).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/serveos_dev?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5433/serveos_dev?schema=public
# Separate database that the automated API tests wipe and recreate.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/serveos_test?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Payments. `dev` is a simulated gateway for development only; it is refused in production.
PAYMENT_PROVIDER=dev
PAYMENT_WEBHOOK_SECRET=

# File storage for product images. Only `local` (disk) is implemented.
STORAGE_PROVIDER=local

# Email. `dev` writes messages to the API log and the dev outbox instead of sending them.
EMAIL_PROVIDER=dev
EMAIL_FROM=ServeOS <no-reply@serveos.local>

# Development seed only: password assigned to the demo users.
SEED_DEMO_PASSWORD=
