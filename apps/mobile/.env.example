# Copy to .env.local (ignored by git). Everything prefixed EXPO_PUBLIC_ is compiled into the
# app and readable by anyone who has it: NEVER put secrets, passwords or API keys here.

# Origin of the ServeOS API (no trailing slash, no /api/v1).
#   iOS simulator on the same computer:  http://localhost:4000
#   Android emulator:                    http://10.0.2.2:4000
#   Physical phone (Expo Go / dev build): http://<your computer's LAN IP>:4000  e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Push notifications are a scaffold only and stay off unless this is "true" AND an EAS project id
# is configured. See README.md -> Push notifications. Leave it unset.
# EXPO_PUBLIC_PUSH_ENABLED=false
